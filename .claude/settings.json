{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run build)",
			"Bash(npm run format)",
			"Bash(npm run format:check)",
			"Bash(npx prettier:*)",
			"Bash(npx tsc:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)"
		],
		"ask": [
			"Bash(npm run deploy:*)",
			"Bash(npm run aws:*)",
			"Bash(npm run ingest:*)",
			"Bash(npm run ingest)"
		],
		"deny": ["Read(**/*.pem)"]
	}
}
