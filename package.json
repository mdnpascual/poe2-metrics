{
	"name": "poe2-build-explorer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=18.17"
	},
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx watch server/index.ts",
		"backend": "tsx server/index.ts",
		"frontend": "vite",
		"build": "tsc -b && vite build",
		"codegen": "graphql-codegen",
		"ingest": "tsx server/ingest.ts",
		"ingest:v2": "tsx server/ingestv2.ts",
		"deploy:frontend": "tsx server/deploy.ts frontend",
		"deploy:db": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target db",
		"deploy:backend": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target backend",
		"deploy:all": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target all",
		"aws:start": "powershell -ExecutionPolicy Bypass -File aws-start.ps1",
		"aws:stop": "powershell -ExecutionPolicy Bypass -File aws-stop.ps1",
		"aws:deploy": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target all",
		"aws:deploy:backend": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target backend",
		"aws:deploy:db": "powershell -ExecutionPolicy Bypass -File deploy-ec2.ps1 -Target db",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@apollo/server": "^4.11.0",
		"@tanstack/react-table": "^8.20.0",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/fs-extra": "^11.0.4",
		"@urql/core": "^5.1.0",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"duckdb": "^1.0.0",
		"express": "^5.2.1",
		"fs-extra": "^11.3.5",
		"graphql": "^16.9.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"recharts": "^2.13.0",
		"urql": "^4.2.0"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^5.0.0",
		"@graphql-codegen/typescript": "^4.0.0",
		"@graphql-codegen/typescript-operations": "^4.0.0",
		"@graphql-codegen/typescript-urql": "^4.0.0",
		"@types/node": "^22.5.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.41",
		"prettier": "^3.3.3",
		"tailwindcss": "^3.4.10",
		"tsx": "^4.16.0",
		"typescript": "^5.5.4",
		"vite": "^6.0.0"
	}
}
